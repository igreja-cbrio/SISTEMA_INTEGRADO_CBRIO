# ── Supabase ──────────────────────────────────────────────
SUPABASE_URL=https://hhntwfawfnxvuobhdfkb.supabase.co
SUPABASE_SERVICE_ROLE_KEY=seu_service_role_key_aqui
SUPABASE_ANON_KEY=seu_anon_key_aqui

# ── Banco Supabase (Postgres direto via pooler) ────────────
# Encontre em: Supabase Dashboard > Settings > Database > Connection string (Transaction)
DATABASE_URL=postgresql://postgres.hhntwfawfnxvuobhdfkb:[sua_senha]@aws-0-us-west-2.pooler.supabase.com:6543/postgres

# ── App ───────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:5173

# ── IA (Anthropic) ────────────────────────────────────────
ANTHROPIC_API_KEY=seu_anthropic_key_aqui

# ── Vercel Cron ──────────────────────────────────────────
CRON_SECRET=seu_cron_secret_aqui

# ── Microsoft Graph (Cerebro / SharePoint) ────────────────
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=

# ── Totem Kids · Pager Bridge (agente local da recepcao) ──
# Token compartilhado com o agente pager-bridge (mesmo valor nos dois lados).
# Gere com: openssl rand -hex 32
PAGER_BRIDGE_TOKEN=

# ── Pagamentos (inscricao paga · retiro, cursos, eventos) ──
# Sem nenhuma destas, o sistema roda no provider 'manual': nada cobra online e
# todo evento pago se recusa a abrir com aviso na pagina publica. Isso e seguro
# por decisao - nao e bug.
#
# Kill switch. Ausente ou 1 = ligado. Somente '0'/'false' desligam, e desligar
# recusa apenas cobranca NOVA: consultar/expirar/reconciliar seguem rodando,
# senao dinheiro ja cobrado ficaria preso.
PAG_ENABLED=1
# Precisa ser 'mercadopago' (ou 'asaas') pra cobrar de verdade. Default 'manual'.
PAG_PROVIDER_PADRAO=manual
# Fallback do segredo de webhook quando nao ha <PROVIDER>_WEBHOOK_SECRET.
PAG_WEBHOOK_SECRET=

# ── Asaas (PSP) ───────────────────────────────────────────
# ⚠️ O PREFIXO DA CHAVE PRECISA CASAR COM O AMBIENTE, senao o adapter lanca na
# primeira chamada (nao no boot - o erro aparece ao criar a primeira cobranca):
#   $aact_hmlg_  = sandbox  -> so em preview/development
#   $aact_prod_  = producao -> so em production
# Isso separa "o teste nao cobrou" de "o teste cobrou de verdade". Na Vercel,
# chave de sandbox vai no escopo Preview; NUNCA em Production.
ASAAS_API_KEY=
# Opcional. Sem ela o adapter escolhe sozinho pelo ambiente
# (api.asaas.com/v3 em producao, api-sandbox.asaas.com/v3 fora).
ASAAS_BASE_URL=
# Token que VOCE cadastra no painel do Asaas. Ele o devolve no header
# 'asaas-access-token' (nao e HMAC). Fail-closed: sem isto, TODO webhook
# responde 401 e nenhum pagamento e confirmado.
ASAAS_WEBHOOK_SECRET=

# ── Mercado Pago (PSP) ────────────────────────────────────
# ⚠️⚠️ NAO EXISTE PREFIXO QUE DISTINGA TOKEN DE TESTE DO DE PRODUCAO. A doc do
# MP diz textualmente que o Access Token de teste comeca com 'APP_USR', igual ao
# de producao. Entao a guarda aqui e OUTRA, em duas partes:
#   (a) MERCADOPAGO_AMBIENTE declara a intencao ('teste' ou 'producao');
#   (b) o adapter confere o 'live_mode' que vem em toda resposta/webhook do MP
#       contra essa declaracao e LANCA se divergir.
# Sem (b) so se descobre pelo extrato: ou o ensaio cobrou de verdade, ou a
# venda de producao nao cobrou ninguem.
#
# Onde pegar: mercadopago.com.br/developers -> Suas integracoes -> (aplicacao)
# -> Credenciais de producao / Credenciais de teste.
MERCADOPAGO_ACCESS_TOKEN=
# 'teste' | 'producao'. Ausente = deriva do ambiente do deploy (VERCEL_ENV
# antes de NODE_ENV, porque a Vercel poe NODE_ENV=production ate em preview).
MERCADOPAGO_AMBIENTE=
# Segredo da assinatura do webhook. Suas integracoes -> Webhooks -> Configurar
# notificacao -> revelar a chave. ⚠️ NAO e o Access Token, e outro valor.
# Fail-closed: sem isto TODO webhook responde 401 e nenhum pagamento e
# confirmado. ⚠️ No painel, marcar os DOIS topicos: 'orders' E 'payment' —
# assinar so um deixa metade das entregas muda.
MERCADOPAGO_WEBHOOK_SECRET=
# Public Key — so sera necessaria se um dia o cartao for tokenizado na nossa
# propria pagina (Checkout Transparente). Hoje o cartao vai pelo checkout
# hospedado do MP e isto fica vazio.
MERCADOPAGO_PUBLIC_KEY=

# ── Generosidade · doacao pela pagina publica /doar ────────
# TODAS OPCIONAIS (tem default no codigo). A doacao depende do MESMO provider
# de pagamento acima: com PAG_PROVIDER_PADRAO=manual a pagina /doar mostra
# "ainda esta sendo preparada" em vez de um formulario que nao consegue cobrar.
#
# Formas oferecidas na doacao (default: pix,cartao). Boleto fica FORA de
# proposito: doacao e impulso, e boleto leva dias uteis pra compensar.
GENEROSIDADE_METODOS=
# Valores sugeridos em REAIS, separados por virgula (default: 20,50,100,200,500).
GENEROSIDADE_VALORES=
# Teto de requisicoes por IP/15min na rota publica (default 3000 em producao).
# A tela faz polling do status e a igreja inteira sai por 1 IP no culto.
GENEROSIDADE_PUBLIC_RATE_LIMIT_MAX=

# ── Sistema · observabilidade Web/Mobile ───────────────────
# Captura em runtime (DSNs públicos por projeto; não reutilizar o token de upload).
SENTRY_DSN=
VITE_SENTRY_DSN=
# O ambiente e a release usam VERCEL_ENV/VERCEL_GIT_COMMIT_SHA automaticamente.
SENTRY_ENV=
SENTRY_RELEASE=
SENTRY_TRACES_RATE=0.1

# Upload de source maps e leitura dos painéis do command center.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT_FRONTEND=
SENTRY_PROJECT_BACKEND=
SENTRY_PROJECT_ANDROID=
SENTRY_PROJECT_IOS=
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
GOOGLE_PLAY_PACKAGE_NAME=br.com.cbrio.app
APP_STORE_CONNECT_ISSUER_ID=
APP_STORE_CONNECT_KEY_ID=
APP_STORE_CONNECT_PRIVATE_KEY=
