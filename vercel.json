{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm install && cd backend && npm install",
  "functions": {
    "api/index.js": {
      "includeFiles": "backend/{server.js,package.json,routes/**,middleware/**,utils/**,services/**,config/**,agents/**,templates/**,adm_tasks_template.json}",
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/health",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/voluntariado/cron/emails",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/totem-kids/cron/age-out",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/totem-kids/cron/resumo-pco",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cerebro/processar",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cerebro/sync-erp",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/api/kpis/youtube/sync",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/governanca/cron/lembrete",
      "schedule": "0 10 * * 1"
    },
    {
      "path": "/api/kpis/cultos/auto-create",
      "schedule": "5 3 * * 0"
    },
    {
      "path": "/api/processos/cron/coletar",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/jornada/cron/refresh-papeis",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/wifi/cron/sync",
      "schedule": "0 2 * * 0,1,4"
    },
    {
      "path": "/api/online/cron/sync",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/online/cron/ds-collect",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/online/cron/ddus-collect",
      "schedule": "30 10 * * *"
    },
    {
      "path": "/api/online/cron/subs-collect",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/online/cron/trafego-collect",
      "schedule": "30 11 * * *"
    },
    {
      "path": "/api/online/cron/retencao-curva-collect",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/online/cron/sub-status-collect",
      "schedule": "30 12 * * *"
    },
    {
      "path": "/api/online/cron/catch-up?limit=20",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/online/cron/engajamento-collect",
      "schedule": "45 12 * * *"
    },
    {
      "path": "/api/online/cron/verificar",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/devocional-planos/cron/enviar-diario",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/devocional-planos/cron/lancar-semanal",
      "schedule": "0 8 * * 1"
    },
    {
      "path": "/api/financeiro/alertas/cron-gerar",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/santander/cron/sync",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/kpis/v2/cron/coletar",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/whatsapp-grupos/cron/diario",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/voluntariado/cron/antecedentes",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/voluntariado/cron/sync",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/face/cron/expurgo",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/whatsapp-cron/aniversarios",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/whatsapp-cron/batismos-lembrete",
      "schedule": "0 21 * * *"
    },
    {
      "path": "/api/notificacoes/cron/alerta-culto-dados",
      "schedule": "0 13 * * 1"
    },
    {
      "path": "/api/monitor-automacoes/cron/checar",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/agente-primeiro-contato/cron/enfileirar",
      "schedule": "5 11 * * *"
    },
    {
      "path": "/api/agente-voluntariado/cron/checar",
      "schedule": "10 11 * * *"
    },
    {
      "path": "/api/agente-batismo-next/cron/enfileirar",
      "schedule": "15 11 * * *"
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/privacidade", "destination": "/privacidade.html" },
    { "source": "/((?!api/|assets/|_vercel/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/models/face-api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
