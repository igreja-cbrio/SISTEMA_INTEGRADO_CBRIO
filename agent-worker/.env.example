# Anthropic API
ANTHROPIC_API_KEY=sk-ant-xxx

# Supabase (service_role · bypass RLS)
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJxxx

# HMAC compartilhado com o Vercel · usado pra autenticar /run inbound
# Gere com: openssl rand -hex 32
AGENT_WORKER_HMAC_SECRET=

# Configuracao
PORT=8080
TZ=America/Sao_Paulo

# Liga/desliga scheduler interno (1 = on)
SCHEDULER_ENABLED=1

# Modelo padrao do executor financeiro
FINANCEIRO_MODEL=claude-sonnet-4-6

# Limite de iteracoes (turnos) por execucao
AGENT_MAX_TURNS=20

# Webhook opcional pro Vercel saber que terminou (POST {runId, status})
# Deixe vazio pra desabilitar
VERCEL_WEBHOOK_URL=

# ─── Agente Dev (Fase 2 · ativação pelo humano) ──────────────────────────────
# Kill-switch: só libera execução com '1' (gate fail-closed)
DEV_AGENT_ENABLED=0
# Token GitHub fine-grained · permissões no repo:
#   Contents: write · Pull requests: write · Checks: read
GITHUB_TOKEN=
# Teto mensal em USD (o runner compara contra SUM(agent_runs.cost_usd) do mês)
DEV_BUDGET_MENSAL_USD=30
# Modelo da implementação e limite de turnos do loop
DEV_MODEL=claude-sonnet-4-6
DEV_MAX_TURNS=60
# Repositório alvo (owner/name) · branch de feature sempre Codex/<desc>
GITHUB_REPO=igreja-cbrio/SISTEMA_INTEGRADO_CBRIO
# Diretório de trabalho (clone) · default: /tmp/cbrio-dev-workspace
# DEV_WORKSPACE_DIR=
# Banco sandbox p/ tarefas que tocam migration (opcional · NUNCA o de produção)
# SANDBOX_DATABASE_URL=
