{
  "name": "cbrio-agent-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Worker de agentes long-running da CBRio · roda no Railway, fora do Vercel serverless",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc && cp -r src/skills dist/",
