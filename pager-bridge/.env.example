# ── CBRio Pager Bridge · configuracao do agente local da recepcao ──

# URL do backend (com /api no final · mesmo dominio do ERP)
API_BASE_URL=https://app.cbrio.org/api

# Token compartilhado · DEVE ser igual ao PAGER_BRIDGE_TOKEN do backend (Vercel)
# Gere com: openssl rand -hex 32
PAGER_BRIDGE_TOKEN=troque-por-um-token-secreto

# Transmissor LRS Freedom na rede local (IP fixo recomendado no DHCP da igreja)
LRS_HOST=192.168.0.50
# Porta do servico NetPage/LRSN no transmissor · CONFIRMAR com a config do Freedom/LRS
LRS_PORT=5000
# Alerta padrao enviado ao coaster (vibra/pisca)
LRS_MESSAGE=Flash5Min
# Timeout da conexao TCP em ms
LRS_TCP_TIMEOUT_MS=5000

# Intervalo de polling da fila em ms
POLL_MS=3000

# DRY_RUN=1 · nao conecta no transmissor · so loga o que faria (pra testar sem hardware)
DRY_RUN=
